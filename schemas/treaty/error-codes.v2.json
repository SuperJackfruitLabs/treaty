{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/treaty/error-codes.v2.json",
  "title": "treaty error codes",
  "description": "Every error code a suite product's API returns, with its status and the envelope it travels in. v2 adds the matrix-error.v1 envelope; v1, whose envelope enum is closed at error.v1 and flat-error.v1, stays beside it for readers pinned to it.",
  "type": "object",
  "required": ["registry", "version", "codes"],
  "properties": {
    "registry": {
      "const": "treaty error codes"
    },
    "version": {
      "const": 2
    },
    "description": {
      "type": "string"
    },
    "codes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "owner", "envelope", "status", "meaning"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "envelope": {
            "enum": ["error.v1", "flat-error.v1", "matrix-error.v1"],
            "description": "The common schema the code travels in: schemas/common/<envelope>.json."
          },
          "alsoStatus": {
            "description": "Other statuses the code is answered with on some routes, each a deliberate exception recorded in meaning.",
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
