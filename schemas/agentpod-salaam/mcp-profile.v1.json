{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/agentpod-salaam/mcp-profile.v1.json",
  "title": "A Salaam daemon's reviewed managed MCP profile",
  "description": "The operator-reviewed file that says which managed MCP servers and tools a station may use, through AgentPod's node proxy on loopback, and within what limits (salaam:src/mcp/protocol.ts mcpProfile, src/mcp/admission.ts readMcpProfile; agentpod:packages/contract/src/salaam-mcp.ts SalaamMcpProfile). Closed throughout: MCP annotations establish no policy. `proxy_origin` is a canonical literal loopback origin with a port. Tool and server names are unique (`x-uniqueBy`). Its digest, with the pins', is what `/v1/health` reports as `managed_mcp.profile_digest`.",
  "type": "object",
  "required": ["version", "scope", "proxy_origin", "servers", "limits"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "scope": {
      "const": "agentpod-proxy"
    },
    "proxy_origin": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^http://(127\\.0\\.0\\.1|\\[::1\\]):(?!80$)(?!0)[0-9]{1,5}$"
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "x-uniqueBy": ["name"],
      "items": {
        "type": "object",
        "required": ["name", "protocol_version", "catalog_digest", "tools"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": ["agentpod", "superlibrary"]
          },
          "protocol_version": {
            "enum": ["2025-06-18", "2025-11-25"]
          },
          "catalog_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "tools": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "x-uniqueBy": ["name"],
            "items": {
              "type": "object",
              "required": ["name", "schema_digest", "policy"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "schema_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "policy": {
                  "enum": ["read", "approval"]
                }
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "request_bytes",
        "response_bytes",
        "timeout_ms",
        "calls_per_attempt"
      ],
      "additionalProperties": false,
      "properties": {
        "request_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "calls_per_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    }
  }
}
