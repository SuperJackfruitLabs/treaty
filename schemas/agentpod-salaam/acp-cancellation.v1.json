{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/agentpod-salaam/acp-cancellation.v1.json",
  "title": "A Salaam cancellation receipt over ACP",
  "description": "What Salaam's ACP adapter reports for a cancellation, to a client that advertised `salaam.dev/executionFeatures.cancellationReceipts` (salaam:src/acp/receipts.ts cancellationReceipts; agentpod:packages/contract/src/salaam-acp.ts SalaamCancellationReceipt). Closed. `confirmed` is claimed only with no active attempt, unresolved operation or unconfirmed resource left.",
  "type": "object",
  "required": [
    "version",
    "sessionId",
    "requestId",
    "targetRequestId",
    "attemptIds",
    "state",
    "activeAttemptIds",
    "unresolvedOperationIds",
    "unconfirmedResources"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "targetRequestId": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "attemptIds": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    },
    "state": {
      "enum": ["requested", "confirmed", "unknown"]
    },
    "activeAttemptIds": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    },
    "unresolvedOperationIds": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "unconfirmedResources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  },
  "if": {
    "properties": {
      "state": {
        "const": "confirmed"
      }
    }
  },
  "then": {
    "properties": {
      "activeAttemptIds": {
        "maxItems": 0
      },
      "unresolvedOperationIds": {
        "maxItems": 0
      },
      "unconfirmedResources": {
        "maxItems": 0
      }
    }
  }
}
