        "created_directories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "snapshotReceipt": {
      "type": "object",
      "required": [
        "version",
        "ok",
        "tree_digest",
        "files",
        "root_identity",
        "snapshot",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "tree_digest": {
          "type": "string",
