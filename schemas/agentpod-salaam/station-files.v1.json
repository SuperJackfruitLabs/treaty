          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "root_identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!(.*/)?\\.\\.?(/|$))[^\\\\\\u0000-\\u001f\\u007f]+$",
          "not": {
            "pattern": "(^|/)(\\.[gG][iI][tT](\\.[^/]*)?|\\.[sS][tT][aA][tT][eE](\\.[^/]*)?|\\.[sS][sS][hH](\\.[^/]*)?|\\.[aA][wW][sS](\\.[^/]*)?|\\.[aA][zZ][uU][rR][eE](\\.[^/]*)?|\\.[cC][oO][nN][fF][iI][gG](\\.[^/]*)?|\\.[nN][pP][mM][rR][cC](\\.[^/]*)?|\\.[nN][eE][tT][rR][cC](\\.[^/]*)?|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS](\\.[^/]*)?|\\.[sS][aA][lL][aA][aA][mM](\\.[^/]*)?|[nN][oO][dD][eE]_[mM][oO][dD][uU][lL][eE][sS](\\.[^/]*)?|\\.[vV][eE][nN][vV](\\.[^/]*)?|\\.[cC][aA][cC][hH][eE](\\.[^/]*)?|\\.[pP][iI](\\.[^/]*)?|\\.[cC][lL][aA][uU][dD][eE](\\.[^/]*)?|\\.[cC][oO][dD][eE][xX](\\.[^/]*)?|\\.[hH][eE][rR][mM][eE][sS](\\.[^/]*)?|\\.[oO][pP][eE][nN][cC][lL][aA][wW](\\.[^/]*)?|\\.[lL][oO][cC][aA][lL](\\.[^/]*)?|\\.[eE][nN][vV][^/]*|\\.[sS][aA][lL][aA][aA][mM]-[sS][tT][aA][tT][iI][oO][nN]-[^/]*|[^/]*\\.[pP][eE][mM]|[^/]*\\.[kK][eE][yY])(/|$)"
          },
          "description": "A clean path beneath the root: no leading slash, no empty, `.` or `..` segment, no backslash or control character, at most 31 slashes (the helper's rule), and no excluded name (`.git`, `.env*`, `.ssh`, `node_modules`, `*.pem`, `*.key` and the rest of agentpod:apps/node-agent/internal/stationfs/files_linux.go excluded, compared case-insensitively)."
        },
        "content": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "patchReceipt": {
      "type": "object",
      "required": [
        "version",
        "ok",
        "tree_digest",
        "files",
        "root_identity",
        "path",
        "sha256",
        "before_tree_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "tree_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "root_identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!(.*/)?\\.\\.?(/|$))[^\\\\\\u0000-\\u001f\\u007f]+$",
          "not": {
            "pattern": "(^|/)(\\.[gG][iI][tT](\\.[^/]*)?|\\.[sS][tT][aA][tT][eE](\\.[^/]*)?|\\.[sS][sS][hH](\\.[^/]*)?|\\.[aA][wW][sS](\\.[^/]*)?|\\.[aA][zZ][uU][rR][eE](\\.[^/]*)?|\\.[cC][oO][nN][fF][iI][gG](\\.[^/]*)?|\\.[nN][pP][mM][rR][cC](\\.[^/]*)?|\\.[nN][eE][tT][rR][cC](\\.[^/]*)?|[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS](\\.[^/]*)?|\\.[sS][aA][lL][aA][aA][mM](\\.[^/]*)?|[nN][oO][dD][eE]_[mM][oO][dD][uU][lL][eE][sS](\\.[^/]*)?|\\.[vV][eE][nN][vV](\\.[^/]*)?|\\.[cC][aA][cC][hH][eE](\\.[^/]*)?|\\.[pP][iI](\\.[^/]*)?|\\.[cC][lL][aA][uU][dD][eE](\\.[^/]*)?|\\.[cC][oO][dD][eE][xX](\\.[^/]*)?|\\.[hH][eE][rR][mM][eE][sS](\\.[^/]*)?|\\.[oO][pP][eE][nN][cC][lL][aA][wW](\\.[^/]*)?|\\.[lL][oO][cC][aA][lL](\\.[^/]*)?|\\.[eE][nN][vV][^/]*|\\.[sS][aA][lL][aA][aA][mM]-[sS][tT][aA][tT][iI][oO][nN]-[^/]*|[^/]*\\.[pP][eE][mM]|[^/]*\\.[kK][eE][yY])(/|$)"
