{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/superbench-consumers/locality.v1.json",
  "title": "PROPOSED SuperBench locality",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "bench",
    "host_id",
    "snapshot",
    "observed_at_ms",
    "expires_at_ms",
    "state"
  ],
  "properties": {
    "version": {
      "const": "superbench.locality.v1"
    },
    "bench": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "bench_id"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "bench_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    },
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state": {
      "enum": ["retained", "unavailable"]
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "retained"
          }
        }
      },
      "then": {
        "required": ["checkpoint_id"]
      },
      "else": {
        "not": {
          "required": ["checkpoint_id"]
        }
      }
    }
  ]
}
