{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/superbench-consumers/lifecycle.v1.json",
  "title": "PROPOSED SuperBench lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stream_id",
    "event_id",
    "sequence",
    "kind",
    "bench",
    "host_id",
    "recorded_at_ms"
  ],
  "properties": {
    "version": {
      "const": "superbench.lifecycle.v1"
    },
    "stream_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:-]*$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "enum": ["created", "leased", "checkpointed", "recovered", "archived"]
    },
    "bench": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "bench_id"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "bench_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    },
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "recorded_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "checkpointed"
          }
        }
      },
      "then": {
        "required": ["checkpoint_id"]
      },
      "else": {
        "not": {
          "required": ["checkpoint_id"]
        }
      }
    }
  ]
}
