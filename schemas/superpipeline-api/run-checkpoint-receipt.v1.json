{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/superpipeline-api/run-checkpoint-receipt.v1.json",
  "title": "PROPOSED cap-free immutable settlement receipt subsection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "settlementId",
    "reportDigest",
    "runId",
    "leaseEpoch",
    "recordedAt",
    "checkpoint",
    "requestDigest",
    "reportedBy"
  ],
  "properties": {
    "version": {
      "const": "superpipeline.run-checkpoint-receipt.v1"
    },
    "settlementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}(?![\\s\\S])"
    },
    "reportDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^run_[A-Za-z0-9]{6,}(?![\\s\\S])"
    },
    "leaseEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 35
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "key",
        "benchId",
        "requestId",
        "generationId",
        "seal",
        "manifestSha256",
        "members",
        "checkpointRepository"
      ],
      "properties": {
        "protocol": {
          "const": "superbench.v2"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}(?![\\s\\S])"
        },
        "benchId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}(?![\\s\\S])"
        },
        "generationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
        },
        "seal": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})(?![\\s\\S])"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "provider",
              "repository",
              "branch",
              "objectFormat",
              "commit"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"
              },
              "provider": {
                "enum": ["forge", "github"]
              },
              "repository": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?![\\s\\S])"
              },
              "branch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^card/card_[A-Za-z0-9]{6,}(?![\\s\\S])"
              },
              "objectFormat": {
                "enum": ["sha1", "sha256"]
              },
              "commit": {
                "type": "string",
                "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})(?![\\s\\S])"
              }
            }
          }
        },
        "checkpointRepository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"
        }
      }
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "reportedBy": {
      "type": "string",
      "pattern": "^prn_[A-Za-z0-9]{6,}(?![\\s\\S])",
      "maxLength": 80
    }
  }
}
