{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/matrix/dev.agentpod.permission.v2.json",
  "title": "dev.agentpod.permission.v2",
  "description": "A harness permission prompt in AgentPod's decision envelope, on the station room's prose message beside the v1 card: options with what they mean and how far they reach, and a harness-permission/v1 subject whose preview shows what the agent would do. Readers ignore properties they do not know. x-uniqueBy lists paths whose values must not repeat (JSON Schema cannot say so): `a[].b` is field b of each item of list a.",
  "type": "object",
  "required": [
    "suite_event_type",
    "schema_version",
    "request_id",
    "session_id",
    "request_seq",
    "title",
    "options",
    "subject"
  ],
  "properties": {
    "msgtype": {
      "const": "m.text"
    },
    "body": {
      "type": "string"
    },
    "suite_event_type": {
      "const": "dev.agentpod.permission.v2"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "request_seq": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "tool_kind": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "meaning"],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "meaning": {
            "enum": ["approve", "reject", "choose"]
          },
          "scope": {
            "enum": ["once", "always"]
          }
        }
      }
    },
    "subject": {
      "allOf": [
        {
          "$ref": "#/$defs/subject"
        },
        {
          "properties": {
            "schema": {
              "const": "harness-permission/v1"
            }
          }
        }
      ]
    }
  },
  "x-uniqueBy": ["options[].id"],
  "$defs": {
    "previewBlock": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": {
              "const": "text"
            },
            "label": {
              "type": "string",
              "maxLength": 200
            },
            "text": {
              "type": "string",
              "maxLength": 4000
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "label", "value"],
          "properties": {
            "type": {
              "const": "field"
            },
            "label": {
              "type": "string",
              "maxLength": 200
            },
            "value": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "label", "url"],
          "properties": {
            "type": {
              "const": "link"
            },
            "label": {
              "type": "string",
              "maxLength": 200
            },
            "url": {
              "type": "string",
              "maxLength": 4000,
              "pattern": "^https?://[^\\s<>]+$"
            }
          }
        }
      ]
    },
    "subject": {
      "type": "object",
      "description": "The exact thing an approving answer approves, re-bounded by the carrier. The sender still lists approving options when preview_complete is false; a client must not offer them, and the carrier refuses an approving answer to an incomplete preview.",
      "required": [
        "id",
        "digest",
        "schema",
        "revision",
        "expires_at",
        "preview",
        "preview_complete"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "expires_at": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "preview": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/previewBlock"
          }
        },
        "preview_complete": {
          "type": "boolean"
        }
      }
    }
  }
}
