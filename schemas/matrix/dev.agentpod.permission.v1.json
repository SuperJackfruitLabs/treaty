{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/matrix/dev.agentpod.permission.v1.json",
  "title": "dev.agentpod.permission.v1",
  "description": "The legacy custom event a permission request is sent as beside its prose message; the same payload as the embedded card. Readers ignore properties they do not know.",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "request_seq",
    "title",
    "options"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string"
    },
    "request_seq": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["option_id", "name"],
        "properties": {
          "option_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
