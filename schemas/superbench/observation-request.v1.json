{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treaty.superjackfruit.com/schemas/superbench/observation-request.v1.json",
  "title": "PROPOSED bounded SuperBench reader request; no mutation or terminal authority",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "superbench.observation.v1"
        },
        "operation": {
          "const": "inventory"
        },
        "snapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": ["version", "operation"]
    },
    {
      "type": "object",
      "additionalProperties": false,
