          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "bench_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-f0-9]{32}$"
