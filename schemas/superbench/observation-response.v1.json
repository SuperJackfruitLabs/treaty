{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/superbench/observation-response.v1.json",
  "title": "PROPOSED redacted reader observations; digests do not prove writer quiescence",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "superbench.observation.v1"
        },
        "operation": {
          "const": "inventory"
        },
        "ok": {
          "const": true
        },
        "snapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "expires_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                  },
                  "bench_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[a-f0-9]{32}$"
                  },
                  "kind": {
                    "enum": ["scalar", "workspace"]
                  },
                  "phase": {
                    "enum": [
                      "materializing",
                      "initializing",
                      "prepared",
                      "ready",
                      "archived",
                      "reaping",
                      "reaped"
                    ]
                  },
                  "availability": {
                    "enum": ["held", "unleased", "blocked"]
                  },
                  "member_names": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                    },
                    "maxItems": 32
                  },
                  "checkpoint": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "scalar"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "commit": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                          }
                        },
                        "required": ["kind", "id", "commit"]
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kind": {
                            "const": "workspace"
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "generation": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 32,
                            "pattern": "^[a-f0-9]{32}$"
                          },
                          "seal": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                          },
                          "manifest_sha256": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "checkpoint_repository": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                          },
                          "members": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "name": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 64,
                                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                                },
                                "branch": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 255
                                },
                                "object_format": {
                                  "enum": ["sha1", "sha256"]
                                },
                                "commit": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 64,
                                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                                }
                              },
                              "required": [
                                "name",
                                "branch",
                                "object_format",
                                "commit"
                              ]
                            },
                            "maxItems": 32
                          }
                        },
                        "required": [
                          "kind",
                          "id",
                          "generation",
                          "seal",
                          "manifest_sha256",
                          "checkpoint_repository",
                          "members"
                        ]
                      }
                    ]
                  },
                  "pending_checkpoint": {
                    "type": "boolean"
                  },
                  "transfer_state": {
                    "enum": ["relinquishing", "transferred"]
                  },
                  "history": {
                    "enum": ["retained", "latest_only", "unavailable"]
                  },
                  "host": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "required": ["id", "label"]
                  },
                  "storage": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "used": {
                        "$ref": "#/$defs/byteObservation"
                      },
                      "quota": {
                        "$ref": "#/$defs/byteObservation"
                      },
                      "allocated": {
                        "$ref": "#/$defs/byteObservation"
                      }
                    },
                    "required": ["used", "quota", "allocated"]
                  },
                  "holder": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "source": {
                        "enum": ["local", "run", "agent", "unknown"]
                      },
                      "display": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "run": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "agent": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "required": ["name", "source", "display"]
                  }
                },
                "required": [
                  "key",
                  "bench_id",
                  "kind",
                  "phase",
                  "availability",
                  "member_names",
                  "pending_checkpoint",
                  "history",
                  "host",
                  "storage"
                ]
              },
              "maxItems": 100
            },
            "next_cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "complete": {
              "type": "boolean"
            }
          },
          "required": ["items", "complete"]
        }
      },
      "required": [
        "version",
        "operation",
        "ok",
        "snapshot",
        "observed_at",
        "expires_at",
        "result"
      ]
    },
