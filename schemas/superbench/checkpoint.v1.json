{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SuperJackfruitLabs/treaty/main/schemas/superbench/checkpoint.v1.json",
  "title": "SuperBench multi-repository checkpoint manifest v1",
  "description": "PROPOSED extension for a complete checkpoint generation, not a deployment claim or a new audience or authority. Semantic validation must require members sorted by unique name, checkpoint_repository naming a member, unique (repository, task_ref) pairs, each pin_ref exactly refs/tags/superbench/pins/<bench_id>/<generation_id>/<name>, and previous_manifest_commit matching the checkpoint repository object format. The payload contains no digest: its digest is external SHA-256 over the raw checkpoint.json blob, avoiding circular canonicalization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "bench_id",
    "generation_id",
    "checkpoint_repository",
    "members"
  ],
  "properties": {
    "version": {
      "const": "superbench.checkpoint.v1"
    },
    "bench_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}(?![\\s\\S])"
    },
    "checkpoint_repository": {
      "$ref": "#/$defs/repository_name"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/member"
      }
    },
    "previous_manifest_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])",
      "description": "Omit for genesis. Otherwise the previous manifest commit must match the checkpoint repository object format."
    }
  },
  "$defs": {
    "repository_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"
    },
    "branch_ref": {
      "type": "string",
      "description": "Full Git branch ref. Unicode and slash-separated components are permitted.",
      "allOf": [
        {
          "pattern": "^refs/heads/.+(?![\\s\\S])"
        },
        {
          "not": {
            "pattern": "[\\u0000-\\u0020\\u007f~^:?*]|\\[|\\\\"
          }
        },
        {
          "not": {
            "pattern": "\\.\\.|@\\{|//"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\."
          }
        },
        {
          "not": {
            "pattern": "\\.lock(/|$)"
          }
        },
        {
          "not": {
            "pattern": "[./]$"
          }
        }
      ]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "task_ref",
        "pin_ref",
        "object_format",
        "commit"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/repository_name"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^-\\u0000\\r\\n][^\\u0000\\r\\n]*(?![\\s\\S])",
          "description": "Repository identity. Credential and authorization constraints are validated separately; this value grants no authority."
        },
        "task_ref": {
          "$ref": "#/$defs/branch_ref"
        },
        "pin_ref": {
          "$ref": "#/$defs/tag_ref",
          "description": "Must equal refs/tags/superbench/pins/<bench_id>/<generation_id>/<name>; cross-field equality requires semantic validation."
        },
        "object_format": {
          "enum": ["sha1", "sha256"]
        },
        "commit": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "object_format": {
              "const": "sha1"
            },
            "commit": {
              "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
            }
          }
        },
        {
          "properties": {
            "object_format": {
              "const": "sha256"
            },
            "commit": {
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            }
          }
        }
      ]
    },
    "tag_ref": {
      "type": "string",
      "description": "Full Git tag ref for an immutable generation pin. Unicode and slash-separated components are permitted.",
      "allOf": [
        {
          "pattern": "^refs/tags/.+(?![\\s\\S])"
        },
        {
          "not": {
            "pattern": "[\\u0000-\\u0020\\u007f~^:?*]|\\[|\\\\"
          }
        },
        {
          "not": {
            "pattern": "\\.\\.|@\\{|//"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\."
          }
        },
        {
          "not": {
            "pattern": "\\.lock(/|$)"
          }
        },
        {
          "not": {
            "pattern": "[./]$"
          }
        }
      ]
    }
  }
}
