{
  "name": "treaty",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "bun scripts/lint.mjs",
    "test": "bun test",
    "check": "bun run fmt:check && bun run typecheck && bun run lint && bun run test && bun run build",
    "build": "bun run --filter './packages/*' build"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@electric-sql/pglite": "0.3.14",
    "@types/bun": "1.2.8",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
