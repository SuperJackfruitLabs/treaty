{
  "product": "Treaty",
  "ci": {
    "forge": "https://forge.superjackfruit.com",
    "repo": "SuperJackfruitLabs/treaty",
    "context": "ci / check (push)",
    "check_command": "bash deploy/release/check.sh"
  },
  "publish": { "script": "deploy/release/publish.sh", "environment": "npm" },
  "deploy": { "ssh_command": "treaty" },
  "smoke": {
    "url": "https://relay.superjackfruit.com/healthz",
    "retries": 10,
    "delay_s": 3
  },
  "rollback": { "ssh_command": "treaty" }
}
