  "producer": [
    {
      "name": "refused-on-entry",
      "expected": "reject",
      "rule": "a card created, moved or edited into a stage whose cards choose, naming a repository outside the allowlist, a start repository it did not choose, or two or more repositories without a resolvable start, is refused with a named error; nothing is stored",
      "scope": "producer-state assertions; not wire-only validation"
    },
    {
      "name": "no-choice-enters-and-waits",
      "expected": "accept",
      "rule": "a card naming no repository may enter a stage with several repositories and no default; at claim it is parked for a person (needsHuman blocked, naming why), never benched with every repository",
      "scope": "producer-state assertions; not wire-only validation"
    },
    {
      "name": "allowlist-shrinks-after-entry",
      "expected": "reject",
      "rule": "the claim recomputes the narrowing from the current stage policy; a choice no longer inside it parks the card for a person instead of claiming, and never drops the missing repository silently",
      "scope": "producer-state assertions; not wire-only validation"
    },
    {
      "name": "frozen-once-a-bench-exists",
      "expected": "reject",
      "rule": "changing a card's repositories or start repository while a bench exists for the card is refused; reclaim the bench, then a new claim starts a new bench",
      "scope": "producer-state assertions; not wire-only validation"
    },
    {
      "name": "claim-freezes-the-selection",
      "expected": "accept",
      "rule": "the claim row stores the stage policy digest, the selection and the narrowed policy; source admission, settlement and references compare with the narrowed policy, and a stage policy change before settlement makes the claim stale",
      "scope": "producer-state assertions; not wire-only validation"
    },
    {
      "name": "old-claimant-never-offered",
      "expected": "reject",
      "rule": "a claimant whose checkpointProtocols does not list superpipeline.checkpoint-claim.v2 is never offered a stage with cardCheckpointPolicy, including with checkpointOnly",
      "scope": "producer-state assertions; not wire-only validation"
    },
    {
      "name": "fixed-stage-unchanged",
      "expected": "accept",
      "rule": "a stage with checkpointPolicy v1 behaves byte for byte as before for every claimant: no selection, policy equals the stage policy, the card's repositories are ignored",
      "scope": "producer-state assertions; not wire-only validation"
    },
    {
      "name": "one-policy-per-stage",
      "expected": "reject",
      "rule": "a stage carrying both checkpointPolicy and cardCheckpointPolicy is refused when the policy is written",
      "scope": "producer-state assertions; not wire-only validation"
    },
    {
      "name": "card-writers-choose",
      "expected": "accept",
      "rule": "any person or agent that may edit the card may set its repositories within the allowlist; one that may not edit the card may not; the allowlist itself stays an owner or admin write",
      "scope": "producer-state assertions; not wire-only validation"
    },
    {
      "name": "default-change-spares-existing-claims",
      "expected": "accept",
      "rule": "changing a stage default changes only claims made afterwards; an existing claim and its bench keep their frozen selection",
      "scope": "producer-state assertions; not wire-only validation"
    }
  ]
