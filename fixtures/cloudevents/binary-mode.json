        "ce-source": "http://example.com/source",
        "ce-type": "com.example.MinEvent",
        "content-type": "application/cloudevents+json; charset=utf-8"
      },
      "why": "a Content-Type starting application/cloudevents means structured (or batched) mode, whatever else the headers say; this codec speaks binary mode only"
    },
