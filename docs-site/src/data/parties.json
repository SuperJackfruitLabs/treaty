      "producers": [
        "SuperPipeline"
      ],
      "consumers": [
        {
          "product": "SuperDispatch",
          "how": "Places the card at once, alone, inside the board's placement window. A hint, not a fact: it reads the board before it places anything."
        }
      ]
    },
