{
  "$comment": "Who sends and who reads each schema's events. Hand-kept: treaty's schemas and catalogue name the producer of SuperPipeline's events, and nothing in them names a consumer. scripts/check-claims.mjs fails the build when a schema has no entry here, an entry names no schema, or a producer disagrees with schemas/catalog.json.",
  "products": {
    "SuperPipeline": "https://docs.superpipeline.dev",
    "SuperExchange": "https://docs.superexchange.dev",
    "AgentPod": "https://docs.agentpod.dev",
    "SuperDispatch": "https://docs.superdispatch.dev",
    "SuperMessage": "https://docs.supermessage.dev"
  },
  "carrierNote": "The carrier is whichever service carries the board's chat: AgentPod's hub, or SuperExchange for a board that has moved to it.",
  "schemas": {
    "superpipeline/attention.pending.v1": {
      "relayed": true,
      "producers": [
        "SuperPipeline"
      ],
      "consumers": [
        {
          "product": "SuperExchange",
          "how": "Posts it to the board's room, for the boards it carries. Receives it through the relay."
        },
        {
          "product": "AgentPod",
          "how": "The hub's board chat posts it, for the boards it still carries."
        },
        {
          "product": "SuperDispatch",
          "how": "Takes it as a nudge to look at the board soon, on a board opted into scheduling. Reads nothing from its data."
        }
      ]
    },
    "superpipeline/card.ready.v1": {
